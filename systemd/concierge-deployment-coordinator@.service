[Unit]
Description=Slack Concierge deployment coordinator candidate slot %i
After=concierge-deployment-kernel.service
Requires=concierge-deployment-kernel.service

[Service]
Type=simple
User=concierge-deploy
Group=concierge-deploy
ExecStart=/usr/local/lib/concierge-deployment/bun /usr/local/lib/concierge-deployment/coordinator/slots/%i/coordinator.js
Restart=always
RestartSec=3
Environment=HOME=/var/lib/concierge-deploy
Environment=CONCIERGE_DEPLOYMENT_SOCKET_DIR=/run/concierge-deployment
Environment=CONCIERGE_COORDINATOR_SLOT=%i
Environment=CONCIERGE_COORDINATOR_VERSION_PATH=/var/lib/concierge-deploy/runtime-version-%i
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/usr/local/lib/concierge-deployment/coordinator /run/concierge-deployment
ReadWritePaths=/var/lib/concierge-deploy
MemoryMax=256M
TasksMax=64
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
