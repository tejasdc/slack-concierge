[Unit]
Description=Slack Concierge deployment rollout supervisor %i
After=concierge-deployment-kernel.service
Requires=concierge-deployment-kernel.service

[Service]
Type=simple
User=concierge-rollout
Group=concierge-rollout
ExecStart=/usr/local/lib/concierge-deployment/bun /usr/local/lib/concierge-deployment/rollout/current/rollout.js %i
Restart=on-failure
RestartSec=3
Environment=HOME=/var/lib/concierge-rollout
Environment=CONCIERGE_DEPLOYMENT_SOCKET_DIR=/run/concierge-deployment
Environment=CONCIERGE_ROLLOUT_UNIT=concierge-deployment-rollout@%i.service
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/usr/local/lib/concierge-deployment/rollout /run/concierge-deployment
ReadWritePaths=/var/lib/concierge-rollout
MemoryMax=256M
TasksMax=64
StandardOutput=journal
StandardError=journal
