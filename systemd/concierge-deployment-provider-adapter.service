[Unit]
Description=Slack Concierge deployment provider credential adapter
After=network-online.target concierge-deployment-kernel.service
Wants=network-online.target
Requires=concierge-deployment-kernel.service

[Service]
Type=simple
ExecStart=/usr/local/lib/concierge-deployment/bun /usr/local/lib/concierge-deployment/kernel/current/provider-adapter.js
Restart=always
RestartSec=3
Environment=HOME=/root
Environment=CONCIERGE_CODEX_AUTH_PATH=/root/.codex/auth.json
Environment=CONCIERGE_PROVIDER_ADAPTER_SOCKET=/run/concierge-deployment/provider-adapter.sock
Environment=CONCIERGE_PROVIDER_ADAPTER_PORT=41951
Environment=CONCIERGE_PROVIDER_ADAPTER_VERSION_PATH=/run/concierge-deployment/provider-adapter-version
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=tmpfs
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The adapter is the only repair principal allowed to reach the fixed provider
# upstream. Repair and review workers remain loopback-only and capability-gated.
ReadOnlyPaths=/usr/local/lib/concierge-deployment/kernel
BindReadOnlyPaths=/root/.codex/auth.json
ReadWritePaths=/run/concierge-deployment
InaccessiblePaths=/root/.config /root/.local/state /var/lib/concierge-deployment /var/lib/concierge-bot /var/lib/concierge-capture /var/lib/concierge-repair /var/lib/concierge-review /var/lib/concierge-provider /var/lib/concierge-provider-authority
MemoryMax=256M
TasksMax=64
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
