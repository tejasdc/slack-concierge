[Unit]
Description=Concierge Slack bot
After=network-online.target agent-inbox.service
Wants=network-online.target agent-inbox.service

[Service]
Type=simple
ExecStartPre=/usr/bin/test -x /usr/bin/node
ExecStartPre=/usr/bin/test -x /usr/bin/python3
ExecStartPre=/usr/bin/install -d -m 0755 -o root -g root /root/.codex
ExecStartPre=/usr/bin/install -d -m 0700 -o root -g root /root/.codex/app-server-control /root/.codex/app-server-daemon
ExecStartPre=/root/.codex/packages/standalone/current/codex app-server daemon start
ExecStartPre=/usr/local/lib/slack-concierge-deployment/control recover
ExecStart=/usr/local/lib/slack-concierge-deployment/launch
WorkingDirectory=/root/workspace/slack-concierge
Restart=always
RestartSec=5
TimeoutStopSec=5min
KillMode=mixed
LimitNOFILE=1048576
Environment=HOME=/root
Environment=CONCIERGE_STATE_DIR=/root/.local/state/concierge
Environment=CONCIERGE_SESSION_CAPABILITY_SOCKET=/run/thinkering/session-capabilities.sock
Environment=CONCIERGE_CAPTURE_QUEUE_URL=http://127.0.0.1:8081
Environment=CONCIERGE_CODEX_REMOTE_EXCLUDE_CHANNELS=C0BNNP6U6GN,D0BMWUJ3RD5,slack-inbox
Environment=CONCIERGE_PEER_NAME=cloud
Environment=CONCIERGE_PEER_LISTEN=100.118.245.110:8788
Environment=CONCIERGE_PEER_TOKEN_FILE=%d/peer
Environment='CONCIERGE_PEERS=[{"name":"mac","url":"http://100.90.183.122:8788","paths":["/Users/tejasdc/"],"archives":["/root/transcript-archive/mac-claude-projects","/root/transcript-archive/mac-codex-sessions"]}]'
LoadCredential=capture_queue:/etc/concierge/capture-queue.token
LoadCredential=peer:/etc/concierge/peer.token
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
