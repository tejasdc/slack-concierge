[Unit]
Description=Slack Concierge provider broker for %i
Requires=concierge-provider-worker@%i.socket
After=concierge-provider-worker@%i.socket

[Service]
Type=simple
DynamicUser=yes
User=cb-%i
Group=concierge-provider-broker
StateDirectory=concierge-provider-authority/%i
StateDirectoryMode=0700
ExecStart=/usr/local/lib/concierge-deployment/bun /usr/local/lib/concierge-deployment/provider/current/broker.js
Restart=on-failure
RestartSec=2
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateUsers=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
TemporaryFileSystem=/var/lib/concierge-provider-authority:ro
TemporaryFileSystem=/run/concierge-provider:ro
BindReadOnlyPaths=/run/concierge-provider/%i/worker.sock
ReadWritePaths=/var/lib/concierge-provider-authority/%i
InaccessiblePaths=/root /var/lib/concierge-bot /var/lib/concierge-provider /var/lib/concierge-provider-scratch /var/lib/concierge-workspace /run/concierge-deployment
StandardOutput=journal
StandardError=journal
