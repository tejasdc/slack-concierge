[Unit]
Description=Slack Concierge isolated deployment repair worker for incident %i
After=concierge-deployment-kernel.service concierge-deployment-provider-adapter.service
Requires=concierge-deployment-kernel.service concierge-deployment-provider-adapter.service
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
User=concierge-repair
Group=concierge-repair
WorkingDirectory=/var/lib/concierge-repair/incidents/%i/repository
ExecStartPre=/usr/bin/test -x /usr/bin/bwrap
ExecStart=/usr/local/lib/concierge-deployment/bun /usr/local/lib/concierge-deployment/kernel/current/repair-agent.js %i
Restart=on-failure
RestartSec=15
TimeoutStartSec=2h
Environment=HOME=/var/lib/concierge-repair/incidents/%i/home
Environment=CONCIERGE_DEPLOYMENT_SOCKET_DIR=/run/concierge-deployment
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/usr/local/lib/concierge-deployment /run/concierge-deployment/repair.sock
ReadOnlyPaths=/var/lib/concierge-repair/incidents/%i/codex/config.toml
ReadWritePaths=/var/lib/concierge-repair/incidents/%i
BindReadOnlyPaths=/var/lib/concierge-deployment/incidents/%i/repair:/var/lib/concierge-repair/incidents/%i/control
BindReadOnlyPaths=/usr/local/lib/concierge-deployment/dependencies/current/node_modules:/var/lib/concierge-repair/incidents/%i/repository/bot/node_modules
InaccessiblePaths=/root /etc/concierge /root/.codex /root/.config /root/.local/state /var/lib/concierge-deployment/incidents /var/lib/concierge-deployment/reviews
MemoryMax=2G
TasksMax=256
StandardOutput=journal
StandardError=journal
