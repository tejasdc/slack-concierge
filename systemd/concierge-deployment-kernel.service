[Unit]
Description=Slack Concierge protected deployment control kernel
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target systemd-tmpfiles-setup.service

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -m 0700 /root/.local/state/concierge-deployment
ExecStartPre=/usr/bin/install -d -m 0755 /var/lib/concierge-deployment
ExecStart=/usr/local/lib/concierge-deployment/bun /usr/local/lib/concierge-deployment/kernel/current/kernel.js
Restart=always
RestartSec=3
Environment=HOME=/root
Environment=CONCIERGE_REPOSITORY_ROOT=/root/workspace/slack-concierge
Environment=CONCIERGE_DEPLOYMENT_STATE_DIR=/root/.local/state/concierge-deployment
Environment=CONCIERGE_DEPLOYMENT_SOCKET_DIR=/run/concierge-deployment
Environment=CONCIERGE_DEPLOYMENT_KERNEL_ROOT=/usr/local/lib/concierge-deployment/kernel/current
Environment=CONCIERGE_DEPLOYMENT_POLICY_PATH=/usr/local/lib/concierge-deployment/kernel/current/deployment-repair-policy.toml
Environment=CONCIERGE_CAPTURE_STATE_PATH=/var/lib/concierge-capture/state.db
RuntimeDirectory=concierge-deployment
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/root/.local/state/concierge-deployment /root/workspace/slack-concierge/.git /var/lib/concierge-deployment /var/lib/concierge-repair /var/lib/concierge-review /var/lib/concierge-bot/state /var/lib/concierge-capture /run/concierge-deployment /run/systemd
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
