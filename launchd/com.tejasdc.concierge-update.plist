<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Rendered by scripts/install-mac.sh. A one-shot job that updates and restarts the Concierge
       agent from outside its process tree; start it with
       launchctl kickstart gui/$(id -u)/com.tejasdc.concierge-update -->
  <key>Label</key><string>com.tejasdc.concierge-update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@REPO@/scripts/update-mac.sh</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO@</string>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>@STATE@/logs/update.log</string>
  <key>StandardErrorPath</key><string>@STATE@/logs/update.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@HOME@</string>
    <key>PATH</key><string>@HOME@/.local/bin:@HOME@/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>
</dict>
</plist>
