<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tejasdc.concierge-speech</string>
  <key>AssociatedBundleIdentifiers</key><array><string>com.tejasdc.agent-host</string></array>
  <key>ProgramArguments</key>
  <array>
    <string>@LAUNCHER@</string>
    <string>@STATE@/bun/bin/bun</string>
    <string>@REPO@/bot/scripts/live-speech-service.ts</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO@/bot</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>@STATE@/logs/speech.log</string>
  <key>StandardErrorPath</key><string>@STATE@/logs/speech.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@HOME@</string>
    <key>PATH</key><string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
    <key>CONCIERGE_STATE_DIR</key><string>@STATE@</string>
  </dict>
</dict>
</plist>
