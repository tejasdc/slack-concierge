{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "review_id",
    "base_commit",
    "head_commit",
    "tree_digest",
    "policy_digest",
    "enforcement_digest",
    "evidence_digest",
    "checks",
    "blockers"
  ],
  "properties": {
    "verdict": { "enum": ["SHIP", "NO_SHIP"] },
    "review_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "head_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "tree_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "enforcement_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "blockers": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant", "evidence", "severity", "correction"],
        "properties": {
          "invariant": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "correction": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    }
  }
}
