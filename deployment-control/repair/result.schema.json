{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "summary",
    "root_cause",
    "head_commit",
    "focused_tests",
    "retrieval_trace",
    "open_uncertainties",
    "next_action"
  ],
  "properties": {
    "outcome": { "enum": ["proposed", "blocked"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "root_cause": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "head_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "focused_tests": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "status": { "const": "passed" },
          "evidence": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "retrieval_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_entries", "influenced_action"],
      "properties": {
        "selected_entries": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 200 }
        },
        "influenced_action": { "type": "string", "maxLength": 2000 }
      }
    },
    "open_uncertainties": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 1000 }
    },
    "next_action": { "enum": ["submit_for_review", "park"] }
  }
}
