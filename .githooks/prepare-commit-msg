#!/usr/bin/env bash

set -euo pipefail

message_file=$1
token=${CONCIERGE_COMMIT_PROVENANCE:-}

if [ -z "$token" ]; then
  exit 0
fi

if [[ ! "$token" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
  echo "Refusing invalid Concierge commit provenance token." >&2
  exit 1
fi

git interpret-trailers \
  --in-place \
  --if-exists doNothing \
  --if-missing add \
  --trailer "Concierge-Provenance: $token" \
  "$message_file"
