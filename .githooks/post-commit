#!/usr/bin/env bash
# thnkr.ing tells Tejas what a waiting Concierge update brings, using the update note each
# change carries. A note written here, while the author is still at the keyboard, is the only
# reliable moment: at release time the authoring session is usually busy with the very work the
# release is waiting for. This warns and never refuses — a missing sentence must not stop a fix
# from shipping (Tejas, 2026-09-22) — so the note stays the author's responsibility.
#
# Every change gets a sentence — work he cannot see on a screen, and documentation too, because
# an instruction change alters how agents behave and that is exactly what he wants told. There is
# no "internal":
# he threw that out on 2026-09-23 — "I'm not asking for updates only in the visual aspects of it.
# I need to understand, look, what the back end is going … every single thing that is, we are
# changing, every update is gonna matter, right? … Yes, maybe I don't visibly see, but who cares?"

set -euo pipefail

commit=$(git rev-parse HEAD)

# A commit without a sentence leaves his release notice unable to say what changed.
if git show -s --format=%B "$commit" | grep -qiE '^[[:space:]]*Update-note:[[:space:]]*.+'; then
  exit 0
fi
if git notes --ref=refs/notes/update show "$commit" >/dev/null 2>&1; then
  exit 0
fi

cat >&2 <<WARNING

  This commit carries no update note, so thnkr.ing cannot tell Tejas what a
  release containing it brings; his notice will list it as undescribed.

  Write one sentence about what this change does, addressed to him, no code
  terms. Behind-the-scenes work counts and gets a plain sentence of its own
  ("a conversation now keeps the account it started on"); nothing is exempt.

    git notes --ref=refs/notes/update add -m "<sentence>" $commit
    git push origin refs/notes/update

  Nothing is blocked.

WARNING
