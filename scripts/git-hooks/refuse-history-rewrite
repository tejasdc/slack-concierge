#!/bin/sh
# git pre-push: refuses a push that would rewrite history the remote already has, whoever or
# whatever runs it: a forced update of any branch, moving an existing tag, or deleting main.
# A new branch, a fast-forward and deleting a finished task branch all pass.
#
# On 2026-09-23 a session amended a pushed commit and force-pushed the copy over main; the
# deployment chased the vanished original through nine restarts in eleven minutes. Fix a pushed
# mistake with a new commit. The agent harnesses refuse the command before it runs
# (bot/scripts/history-guard.ts); this is the same rule at the push itself.
#
# Usage (as git runs it): pre-push <remote> <url>, with "<local ref> <local sha> <remote ref>
# <remote sha>" lines on stdin.

refuse() {
  echo "" >&2
  echo "  Push refused: $1" >&2
  echo "  Pushed history is never rewritten: fix a pushed mistake with a new commit." >&2
  echo "  If the remote moved on, fetch, then merge or rebase your unpushed work onto it." >&2
  echo "" >&2
  exit 1
}

zero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  if zero "$local_sha"; then
    case "$remote_ref" in
      refs/heads/main|refs/heads/master) refuse "it deletes ${remote_ref#refs/heads/} on $1." ;;
    esac
    continue
  fi
  zero "$remote_sha" && continue
  [ "$local_sha" = "$remote_sha" ] && continue
  case "$remote_ref" in
    refs/tags/*) refuse "the tag ${remote_ref#refs/tags/} already exists on $1 and would move." ;;
  esac
  if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    refuse "$1 has commits on ${remote_ref#refs/heads/} that this checkout does not have."
  fi
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    refuse "it would replace ${remote_ref#refs/heads/} on $1 with history that does not contain it."
  fi
done
exit 0
