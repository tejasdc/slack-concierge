{
  "display_information": {
    "name": "Concierge"
  },
  "features": {
    "agent_view": {
      "agent_description": "Run durable Codex and Claude Code sessions from Slack channels and threads."
    },
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "concierge",
      "always_online": true
    },
    "slash_commands": [
      { "command": "/concierge-status", "description": "Concierge liveness + uptime", "should_escape": false },
      { "command": "/create-channel", "description": "Create channel-backed project", "usage_hint": "<name>", "should_escape": false },
      { "command": "/fork", "description": "Fork the latest agent session", "usage_hint": "[message-ts]", "should_escape": false },
      { "command": "/add-dir", "description": "Add writable dir for this channel", "usage_hint": "<path>", "should_escape": false },
      { "command": "/remove-dir", "description": "Remove writable dir for this channel", "usage_hint": "<path>", "should_escape": false },
      { "command": "/auth-refresh", "description": "Refresh provider OAuth", "usage_hint": "<codex|claude-code>", "should_escape": false },
      { "command": "/todo", "description": "Append a todo (no agent)", "usage_hint": "<text>", "should_escape": false },
      { "command": "/note", "description": "Append a note (no agent)", "usage_hint": "<text>", "should_escape": false },
      { "command": "/switch-provider", "description": "Set channel default provider", "usage_hint": "<codex|claude-code>", "should_escape": false },
      { "command": "/mode", "description": "Set channel mode", "usage_hint": "<agent-auto|agent-tag|silent>", "should_escape": false },
      { "command": "/review-inbox", "description": "Run inbox review pipeline", "should_escape": false }
    ],
    "shortcuts": [
      {
        "name": "Fork from here",
        "type": "message",
        "callback_id": "fork_from_here",
        "description": "Fork the agent session from this message"
      },
      {
        "name": "Compare w another agent",
        "type": "message",
        "callback_id": "compare_with_agent",
        "description": "Replay user prompts in a fresh agent session"
      },
      {
        "name": "Send to inbox",
        "type": "message",
        "callback_id": "send_to_inbox",
        "description": "Append this message to the project inbox"
      },
      {
        "name": "Turn into todo",
        "type": "message",
        "callback_id": "turn_into_todo",
        "description": "Append this message to the project todo list"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "bookmarks:read",
        "bookmarks:write",
        "canvases:read",
        "canvases:write",
        "channels:history",
        "channels:join",
        "channels:manage",
        "channels:read",
        "chat:write",
        "chat:write.customize",
        "chat:write.public",
        "commands",
        "emoji:read",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "links.embed:write",
        "links:read",
        "links:write",
        "lists:read",
        "lists:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "pins:read",
        "pins:write",
        "reactions:read",
        "reactions:write",
        "team:read",
        "users:read",
        "users:read.email"
      ],
      "user": [
        "channels:history",
        "channels:read",
        "chat:write",
        "files:read",
        "files:write",
        "groups:history",
        "identify",
        "im:history",
        "reactions:read",
        "reactions:write",
        "search:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "agent_session_stopped",
        "app_mention",
        "channel_created",
        "file_shared",
        "message.channels",
        "message.groups",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
