{
  "display_information": {
    "name": "Concierge"
  },
  "features": {
    "bot_user": {
      "display_name": "concierge",
      "always_online": true
    },
    "slash_commands": [
      { "command": "/ping", "description": "Concierge liveness check", "usage_hint": "", "should_escape": false },
      { "command": "/new", "description": "Create channel-backed project", "usage_hint": "<name>", "should_escape": false },
      { "command": "/promote", "description": "Promote current channel to coding project", "usage_hint": "", "should_escape": false },
      { "command": "/fork", "description": "Fork the latest persisted agent session", "usage_hint": "[message-ts]", "should_escape": false },
      { "command": "/add-dir", "description": "Add an extra writable directory for this channel", "usage_hint": "<path>", "should_escape": false },
      { "command": "/remove-dir", "description": "Remove an extra writable directory for this channel", "usage_hint": "<path>", "should_escape": false },
      { "command": "/auth-refresh", "description": "Refresh provider OAuth", "usage_hint": "<codex|claude-code>", "should_escape": false },
      { "command": "/todo", "description": "Append a todo without invoking an agent", "usage_hint": "<text>", "should_escape": false },
      { "command": "/note", "description": "Append a note without invoking an agent", "usage_hint": "<text>", "should_escape": false },
      { "command": "/switch-provider", "description": "Set channel default provider", "usage_hint": "<codex|claude-code>", "should_escape": false },
      { "command": "/create-channel", "description": "Create channel-backed project", "usage_hint": "<name>", "should_escape": false },
      { "command": "/mode", "description": "Set channel mode", "usage_hint": "<agent-auto|agent-tag|silent>", "should_escape": false }
    ],
    "shortcuts": [
      {
        "name": "Fork from here",
        "type": "message",
        "callback_id": "fork_from_here",
        "description": "Fork the agent session from this message"
      },
      {
        "name": "Send to inbox",
        "type": "message",
        "callback_id": "send_to_inbox",
        "description": "Append this message to the project inbox"
      },
      {
        "name": "Turn into todo",
        "type": "message",
        "callback_id": "turn_into_todo",
        "description": "Append this message to the project todo list"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:join",
        "channels:manage",
        "channels:read",
        "chat:write",
        "chat:write.public",
        "commands",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "channel_created",
        "file_shared",
        "message.channels",
        "message.groups",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
