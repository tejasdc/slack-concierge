{
  "name": "concierge-bot",
  "version": "0.2.0",
  "description": "Concierge - Slack-driven agent orchestrator",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun run scripts/retry-architecture-lint.ts && bun build src/index.ts src/capture-ingress.ts --target bun --outdir /tmp/concierge-build",
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun run scripts/testing-disabled.ts",
    "sandbox:provision": "bun run scripts/testing-disabled.ts",
    "sandbox:browser": "bun run scripts/testing-disabled.ts",
    "sandbox:typed-turn:plan": "bun run scripts/testing-disabled.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@iarna/toml": "^2.2.5",
    "@slack/bolt": "^4.0.0",
    "ws-node": "npm:ws@8.21.2"
  }
}
